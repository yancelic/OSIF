{
  "expo": {
    "name": "OSIF",
    "slug": "osif",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F2ECE1"
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Doğum günlerini takviminizden içe aktarmak için takvim erişimi gereklidir."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Kişilerinizin doğum günlerini içeri aktarmak için rehber erişimi gereklidir."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "OSIFWidget",
              "label": "OSIF Hızlı Bakış",
              "description": "Yaklaşan doğum günleri ve hediye durumları",
              "minWidth": "160dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d43a8f59-06be-447e-8aeb-dae356409d2e"
      }
    },
    "android": {
      "package": "com.yancelic.osif",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2ECE1"
      },
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_CONTACTS"
      ]
    }
  }
}
